{
  "schema": 1,
  "id": "io.github.artcraftandroid.trace-view",
  "name": "Trace view",
  "version": "1.0.0",
  "holds": ["hooks"],
  "publisher": { "name": "ProCraft" },
  "description": "Layer view, in the Layers panel or Actions > Canvas: Solo shows the layer you're on alone, Trace dims the rest (Alt+S, Alt+T), on the screen alone. What you save and export stays as it is.",
  "compat": { "procraft": { "interface": 13 } },
  "permissions": ["panel"],
  "hooks": ["view_dim_others"],
  "controls": [
    {
      "key": "view", "type": "slider", "label": "Layer view", "least": 0, "most": 2, "step": 1, "starts": 0,
      "names": ["Normal", "Solo", "Trace"], "place": "canvas"
    },
    {
      "key": "dim", "type": "slider", "label": "Trace dims the others", "least": 0.1, "most": 0.95, "step": 0.05,
      "starts": 0.7, "shown_times": 100, "unit": "%", "live": true
    }
  ],
  "actions": [
    { "key": "views", "label": "Layer view", "place": "layers" },
    { "key": "solo", "label": "Solo", "press": "alt+s" },
    { "key": "trace", "label": "Trace", "press": "alt+t" }
  ]
}
