{
  "schema": 1,
  "id": "io.github.artcraftandroid.lasso-fill",
  "name": "Lasso fill",
  "version": "1.1.0",
  "holds": ["hooks", "brushes"],
  "publisher": { "name": "ProCraft" },
  "description": "Strokes that fill what they go round: the Fills brushes it brings, any brush by its Fill row in the brush studio, or every stroke while Lasso fill is on (Actions > Canvas, or Alt+F).",
  "compat": { "procraft": { "interface": 14 } },
  "permissions": [],
  "hooks": ["stroke_fill"],
  "controls": [
    { "key": "every", "type": "switch", "label": "Lasso fill", "starts": false, "place": "canvas", "press": "alt+f" },
    { "key": "growing", "type": "switch", "label": "Show the fill while drawing", "starts": true },
    { "key": "eraser", "type": "switch", "label": "Eraser too", "starts": false }
  ],
  "brush_controls": [
    { "key": "fill", "label": "Fill", "choices": ["Off", "Fill what it encloses"] },
    { "key": "shown", "label": "Fill shown", "choices": ["As it's drawn", "As the pen lifts"] }
  ]
}
