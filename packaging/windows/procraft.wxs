<?xml version="1.0" encoding="utf-8"?>
<!--
  ProCraft's Windows installer (WiX v5 with its UI and Util extensions), built by package.ps1:

    wix build procraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=0.0.3 -d DisplayVersion=0.0.3-beta -d BinDir=... -d IconPath=... -o out.msi

  For every user of the machine, with a wizard: Welcome, the install folder (Program Files\ProCraft
  at first, then wherever the last version went), Ready, progress, and Finish with a ticked
  "Launch ProCraft". It installs ProCraft.exe, Microsoft's DirectX Shader Compiler beside it
  (dxcompiler.dll and dxil.dll, with their licences), the licence files and a Start menu shortcut.
  A newer version takes an older one's place. Modelled on SolidCraft's (tangency-labs/solidcraft).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Distinct UpgradeCode from ProCraft so DreamsCraft installs independently alongside ProCraft. -->
  <Package Name="DreamsCraft" Manufacturer="DreamsCraft" Version="$(var.Version)"
           UpgradeCode="B8F41C2E-7D6A-4E93-9A54-2C8E61D0F7A1" Scope="perMachine" Compressed="yes"
           Language="1033">
    <SummaryInformation Description="DreamsCraft: 2D animation, timeline and painting studio" Manufacturer="DreamsCraft" />
    <!-- the same numbers again: one beta after another of a version replaces the last -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of DreamsCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- an advertised shortcut to an .exe takes an icon whose id ends in .exe (ICE50) -->
    <Icon Id="DreamsCraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DreamsCraftIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Honraan/DreamsCraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Honraan/DreamsCraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Honraan/DreamsCraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="DreamsCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- an upgrade goes where the version before it went (kept by the App component) -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\DreamsCraft" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="DreamsCraft" Level="1">
      <ComponentGroupRef Id="DreamsCraftFiles" />
    </Feature>

    <!-- the install folder wizard without its licence page (MIT OR Apache-2.0: nothing to accept) -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchDreamsCraft"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="DreamsCraft $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch DreamsCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#DreamsCraftExe]" />
    <!-- in the wizard's own (unelevated) process, so the app starts as the user -->
    <CustomAction Id="LaunchDreamsCraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
                  Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="DreamsCraftFiles" Directory="INSTALLFOLDER">
      <Component Id="App" Guid="94C1E3F0-5B2A-4D87-A612-8F3E0D4B7C29">
        <File Id="DreamsCraftExe" Source="$(var.BinDir)\DreamsCraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="DreamsCraft"
                    Description="2D animation, timeline and painting studio" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
                    Icon="DreamsCraftIcon.exe" IconIndex="0" />
        </File>
        <RegistryValue Root="HKLM" Key="Software\DreamsCraft" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
      <Component Id="LicenseMit"><File Source="$(var.BinDir)\LICENSE-MIT" /></Component>
      <Component Id="LicenseApache"><File Source="$(var.BinDir)\LICENSE-APACHE" /></Component>
      <Component Id="Notice"><File Source="$(var.BinDir)\NOTICE" /></Component>
      <Component Id="Attribution"><File Source="$(var.BinDir)\ATTRIBUTION.md" /></Component>
      <!-- Direct3D 12 makes the shaders with these where they are beside DreamsCraft.exe -->
      <Component Id="DxCompiler"><File Source="$(var.BinDir)\dxcompiler.dll" /></Component>
      <Component Id="Dxil"><File Source="$(var.BinDir)\dxil.dll" /></Component>
      <Component Id="DxcLicenseLlvm"><File Source="$(var.BinDir)\DXC-LICENSE-LLVM.txt" /></Component>
      <Component Id="DxcLicenceMit"><File Source="$(var.BinDir)\DXC-LICENCE-MIT.txt" /></Component>
      <Component Id="DxcLicenseMs"><File Source="$(var.BinDir)\DXC-LICENSE-MS.txt" /></Component>
    </ComponentGroup>
  </Fragment>
</Wix>
