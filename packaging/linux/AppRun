#!/usr/bin/env bash
# The AppImage's entry point. Installs DreamsCraft's menu entry and icons into $XDG_DATA_HOME
# so desktop launchers and Wayland find its icon through its app id (dreamscraft), then runs it.
HERE="$(dirname "$(readlink -f "$0")")"
if [ -n "${APPIMAGE:-}" ] && [ -n "${HOME:-}" ]; then
  DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
  {
    for icon in "$HERE"/usr/share/icons/hicolor/*/apps/dreamscraft.png; do
      size="$(basename "$(dirname "$(dirname "$icon")")")"
      mkdir -p "$DATA/icons/hicolor/$size/apps" && cp -f "$icon" "$DATA/icons/hicolor/$size/apps/dreamscraft.png"
    done
    mkdir -p "$DATA/applications" &&
      sed "s|^Exec=.*|Exec=\"$APPIMAGE\" %F|" "$HERE/dreamscraft.desktop" >"$DATA/applications/dreamscraft.desktop"
  } 2>/dev/null
fi
exec "$HERE/usr/bin/dreamscraft" "$@"
